{"v":1,"start":"chapter-1.html","groups":[{"name":"Front matter","items":[{"f":"index.html","id":"about-this-book","t":"About this book","w":44,"s":[]}]},{"name":"Chapters","items":[{"f":"chapter-1.html","t":"முதல் அதிகாரம் - இயற்கைப் புணர்ச்சி","w":2,"s":[]}]},{"name":"களவியல் (1 முதல் 18 அதிகாரங்கள்)","items":[{"f":"chapter-2.html","t":"இரண்டாம் அதிகாரம் - பாற்கற் கூட்டம்","w":2,"s":[]},{"f":"chapter-3.html","t":"மூன்றாம் அதிகாரம் - இடந்தலைப் பாடு","w":2,"s":[]},{"f":"chapter-4.html","t":"நான்காம் அதிகாரம் - மதியுடம்படுத்தல்","w":2,"s":[]},{"f":"chapter-5.html","t":"ஐந்தாம் அதிகாரம் - இருவரும் உள்வழி அவன் வரவுணர்தல்","w":3,"s":[]},{"f":"chapter-6.html","t":"ஆறாம் அதிகாரம் - முன்னுற வுணர்தல்","w":2,"s":[]},{"f":"chapter-7.html","t":"ஏழாம் அதிகாரம் - குறையுற வுணர்தல்","w":2,"s":[]},{"f":"chapter-8.html","t":"எட்டாம் அதிகாரம் - நாண நாட்டம்","w":2,"s":[]},{"f":"chapter-9.html","t":"ஒன்பதாம் அதிகாரம் - நடுங்க நாட்டம்","w":2,"s":[]},{"f":"chapter-10.html","t":"பத்தாம் அதிகாரம் - மடல் திறம்","w":2,"s":[]},{"f":"chapter-11.html","t":"பதினொன்றாம் அதிகாரம் - குறை நயப்புக் கூறல்","w":3,"s":[]},{"f":"chapter-12.html","t":"பன்னிரண்டாம் அதிகாரம் - சேட்படை","w":2,"s":[]},{"f":"chapter-13.html","t":"பதின்மூன்றாம் அதிகாரம் - பகற்குறி","w":2,"s":[]},{"f":"chapter-14.html","t":"பதினென்காம் அதிகாரம் - இரவுக் குறி","w":2,"s":[]},{"f":"chapter-15.html","t":"பதினைந்தாம் அதிகாரம் - ஒருவழித் தணத்தல்","w":3,"s":[]},{"f":"chapter-16.html","t":"பதினாறாம் அதிகாரம் - உடன் போக்கு","w":2,"s":[]},{"f":"chapter-17.html","t":"பதினேழாம் அதிகாரம் - வரைவு முடுக்கம்","w":2,"s":[]},{"f":"chapter-18.html","t":"பதினெட்டாம் அதிகாரம் - வரை பொருட் பிரிதல்","w":3,"s":[]}]},{"name":"கற்பியல் ( 19 - 25 அதிகாரங்கள்)","items":[{"f":"chapter-19.html","t":"பத்தொன்பதாம் அதிகாரம் - மணம் சிறப்புரைத்தல்","w":3,"s":[]},{"f":"chapter-20.html","t":"இருபதாம் அதிகாரம் - ஓதற் பிரிவு","w":2,"s":[]},{"f":"chapter-21.html","t":"இருபத்தொன்றாம் அதிகாரம் - காவற்பிரிவு","w":2,"s":[]},{"f":"chapter-22.html","t":"இருபத்திரண்டாம் அதிக